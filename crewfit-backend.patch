+      interval: 5s
+      retries: 10
+    networks: [crewfit]
+
+  api:
+    build: ./apps/api
+    env_file: ./apps/api/.env
+    environment:
+      DATABASE_URL: postgresql://crewfit:crewfit@db:5432/crewfit
+    ports:
+      - "3000:3000"
+    volumes:
+      - uploads:/app/uploads
+    depends_on:
+      db:
+        condition: service_healthy
+    networks: [crewfit]
+
+volumes:
+  db-data:
+  uploads:
+
+networks:
+  crewfit:
+    driver: bridge
