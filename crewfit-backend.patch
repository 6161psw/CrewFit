+services:
+  db:
+    image: postgres:16-alpine
+    environment:
+      POSTGRES_USER: crewfit
+      POSTGRES_PASSWORD: crewfit
+      POSTGRES_DB: crewfit
+    ports:
+      - "5432:5432"
+    volumes:
+      - db-data:/var/lib/postgresql/data
