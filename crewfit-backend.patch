@@ -0,0 +1,57 @@
+import { Injectable } from '@nestjs/common';
+import { School, UserRole } from '@prisma/client';
+import { AuthUser, authUserInclude } from '../common/auth-user';
+import { PrismaService } from '../prisma/prisma.service';
+import { GoogleProfile } from './auth.types';
+
+@Injectable()
+export class AuthRepository {
+  constructor(private readonly prisma: PrismaService) {}
+
+  findUserById(id: string): Promise<AuthUser | null> {
+    return this.prisma.user.findUnique({ where: { id }, include: authUserInclude });
+  }
+
+  findSchoolById(id: number): Promise<School | null> {
+    return this.prisma.school.findUnique({ where: { id } });
+  }
+
+  async findSchoolByEmail(email: string): Promise<School | null> {
+    const domain = email.split('@')[1]?.toLowerCase();
+    if (!domain) return null;
+    return this.prisma.school.findFirst({ where: { emailDomains: { has: domain } } });
+  }
+
+  /** googleId 또는 email 로 찾아 연결, 없으면 생성. 학교 도메인 메일이면 학교 인증 처리 */
+  async upsertUser(p: Omit<GoogleProfile, 'googleId'> & { googleId?: string }, opts: { superAdmin: boolean; school: School | null }) {
+    const existing = await this.prisma.user.findFirst({
+      where: { OR: [...(p.googleId ? [{ googleId: p.googleId }] : []), { email: p.email }] },
+    });
+    const verify =
+      opts.school && !existing?.schoolVerifiedAt
+        ? { schoolId: opts.school.id, schoolEmail: p.email, schoolVerifiedAt: new Date() }
+        : {};
+    const role = opts.superAdmin ? { role: UserRole.SUPER_ADMIN } : {};
+    const base = { email: p.email, name: p.name, picture: p.picture, ...(p.googleId ? { googleId: p.googleId } : {}) };
+    if (existing) {
+      return this.prisma.user.update({ where: { id: existing.id }, data: { ...base, picture: p.picture ?? existing.picture, ...verify, ...role } });
+    }
+    return this.prisma.user.create({ data: { ...base, ...verify, ...role } });
+  }
+
+  createRefreshToken(userId: string, tokenHash: string, expiresAt: Date) {
+    return this.prisma.refreshToken.create({ data: { userId, tokenHash, expiresAt } });
+  }
+
+  findRefreshToken(tokenHash: string) {
+    return this.prisma.refreshToken.findUnique({ where: { tokenHash } });
+  }
+
+  deleteRefreshToken(tokenHash: string) {
+    return this.prisma.refreshToken.deleteMany({ where: { tokenHash } });
+  }
+
+  deleteExpiredTokens(userId: string) {
+    return this.prisma.refreshToken.deleteMany({ where: { userId, expiresAt: { lt: new Date() } } });
+  }
+}
diff --git a/apps/api/src/auth/auth.service.ts b/apps/api/src/auth/auth.service.ts
new file mode 100644
index 0000000..ec4bef4
--- /dev/null
+++ b/apps/api/src/auth/auth.service.ts
@@ -0,0 +1,94 @@
+import { ForbiddenException, Injectable, Logger, UnauthorizedException } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { JwtService } from '@nestjs/jwt';
+import { createHash, randomBytes } from 'crypto';
+import { OAuth2Client } from 'google-auth-library';
+import { csv, Env } from '../config/env';
+import { AuthRepository } from './auth.repository';
+import { DevLoginDto, GoogleProfile, Tokens } from './auth.types';
+
+const sha256 = (v: string) => createHash('sha256').update(v).digest('hex');
+
+@Injectable()
+export class AuthService {
+  private readonly logger = new Logger(AuthService.name);
+  private readonly google = new OAuth2Client();
+  private readonly superAdmins: string[];
+  private readonly refreshDays: number;
+
+  constructor(
+    private readonly config: ConfigService<Env, true>,
+    private readonly jwt: JwtService,
+    private readonly authRepository: AuthRepository,
+  ) {
+    this.superAdmins = csv(config.get('SUPER_ADMIN_EMAILS', { infer: true })).map((e) => e.toLowerCase());
+    this.refreshDays = config.get('REFRESH_TOKEN_EXPIRE_DAYS', { infer: true });
+  }
+
+  get refreshMaxAgeMs() {
+    return this.refreshDays * 86_400_000;
+  }
+
+  async loginWithGoogle(profile: GoogleProfile): Promise<Tokens> {
+    const school = await this.authRepository.findSchoolByEmail(profile.email);
+    const user = await this.authRepository.upsertUser(profile, {
+      school,
+      superAdmin: this.superAdmins.includes(profile.email),
+    });
+    return this.issueTokens(user.id);
+  }
+
+  /** 앱: 네이티브 구글 로그인 idToken 검증 */
+  async loginWithIdToken(idToken: string): Promise<Tokens> {
+    const audience = [
+      this.config.get('GOOGLE_CLIENT_ID', { infer: true }),
+      ...csv(this.config.get('GOOGLE_MOBILE_CLIENT_IDS', { infer: true })),
+    ];
+    const ticket = await this.google.verifyIdToken({ idToken, audience }).catch(() => {
+      throw new UnauthorizedException('유효하지 않은 구글 토큰');
+    });
+    const p = ticket.getPayload();
+    if (!p?.email || !p.email_verified) throw new UnauthorizedException('구글 이메일 미인증');
+    return this.loginWithGoogle({
+      googleId: p.sub,
+      email: p.email.toLowerCase(),
+      name: p.name ?? p.email.split('@')[0],
+      picture: p.picture ?? null,
+    });
+  }
+
+  async devLogin(dto: DevLoginDto): Promise<Tokens> {
+    const enabled =
+      this.config.get('DEV_LOGIN_ENABLED', { infer: true }) && this.config.get('NODE_ENV', { infer: true }) !== 'production';
+    if (!enabled) throw new ForbiddenException();
+    const email = dto.email.toLowerCase();
+    const school = dto.schoolId
+      ? await this.authRepository.findSchoolById(dto.schoolId)
+      : await this.authRepository.findSchoolByEmail(email);
+    const user = await this.authRepository.upsertUser(
+      { email, name: dto.name ?? email.split('@')[0], picture: null },
+      { school, superAdmin: this.superAdmins.includes(email) },
+    );
+    return this.issueTokens(user.id);
+  }
+
+  /** refresh token 회전: 기존 토큰 폐기 후 새로 발급 */
+  async refresh(refreshToken: string): Promise<Tokens> {
+    const hash = sha256(refreshToken);
+    const row = await this.authRepository.findRefreshToken(hash);
+    if (!row || row.expiresAt < new Date()) throw new UnauthorizedException();
+    await this.authRepository.deleteRefreshToken(hash);
+    return this.issueTokens(row.userId);
+  }
+
+  async logout(refreshToken?: string) {
+    if (refreshToken) await this.authRepository.deleteRefreshToken(sha256(refreshToken));
+  }
+
+  private async issueTokens(userId: string): Promise<Tokens> {
+    const refreshToken = randomBytes(32).toString('base64url');
+    await this.authRepository.deleteExpiredTokens(userId);
+    await this.authRepository.createRefreshToken(userId, sha256(refreshToken), new Date(Date.now() + this.refreshMaxAgeMs));
+    return { accessToken: this.jwt.sign({}, { subject: userId }), refreshToken };
+  }
+}
diff --git a/apps/api/src/auth/auth.types.ts b/apps/api/src/auth/auth.types.ts
new file mode 100644
index 0000000..63d3576
--- /dev/null
+++ b/apps/api/src/auth/auth.types.ts
@@ -0,0 +1,51 @@
+import { IsEmail, IsInt, IsNotEmpty, IsOptional, IsString } from 'class-validator';
+
+export interface GoogleProfile {
+  googleId: string;
+  email: string;
+  name: string;
+  picture: string | null;
+}
+
+export interface JwtPayload {
+  sub?: string;
+}
+
+export interface Tokens {
+  accessToken: string;
+  refreshToken: string;
+}
+
+export class GoogleIdTokenDto {
+  /** 앱 네이티브 구글 로그인 idToken */
+  @IsString()
+  @IsNotEmpty()
+  idToken: string;
+}
+
+export class RefreshDto {
+  /** 앱: body 로 전달. 웹: 생략 (쿠키) */
+  @IsOptional()
+  @IsString()
+  refreshToken?: string;
+}
+
+export class DevLoginDto {
+  @IsEmail()
+  email: string;
+
+  @IsOptional()
