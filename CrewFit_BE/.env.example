NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://crewfit:crewfit@127.0.0.1:5432/crewfit

API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin
# 추가 허용 origin (콤마 구분)
CORS_ALLOWED_ORIGINS=

JWT_SECRET=change-me-to-long-random-string
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRE_DAYS=30

# 구글 로그인 (비우면 비활성 → POST /auth/dev-login 으로 개발). 발급 방법: CrewFit_BE/README.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 비우면 {API_URL}/auth/google/callback
GOOGLE_CALLBACK_URL=
# 앱(iOS/Android) idToken audience 추가 (콤마 구분)
# [v6 변경] Flutter 앱은 serverClientId=GOOGLE_CLIENT_ID(웹) 로 idToken 받음 → 보통 비워둬도 됨.
#           Android OAuth 클라이언트(패키지 kr.crewfit.crewfit + SHA-1)는 Google Cloud 에 "생성만" 필요.
#           폰 접속: API_URL 은 그대로 두고 앱 env.json 의 API_URL=http://<PC IP>:3000
GOOGLE_MOBILE_CLIENT_IDS=

# 웹/API 도메인 다르면 none + true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# 로그인 시 SUPER_ADMIN 자동 부여 (콤마 구분)
SUPER_ADMIN_EMAILS=
# 개발용 POST /auth/dev-login (production 에선 무시)
DEV_LOGIN_ENABLED=true

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
SWAGGER_ENABLED=true
