NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://crewfit:crewfit@127.0.0.1:5432/crewfit

API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin
# 추가 허용 origin (콤마 구분)
CORS_ALLOWED_ORIGINS=

JWT_SECRET=change-me-to-long-random-string
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRE_DAYS=30

# 구글 로그인 (비우면 비활성 → POST /auth/dev-login 으로 개발). 발급 방법: CrewFit_BE/README.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 비우면 {API_URL}/auth/google/callback
GOOGLE_CALLBACK_URL=
# 앱(iOS/Android) idToken audience 추가 (콤마 구분)
GOOGLE_MOBILE_CLIENT_IDS=

# 웹/API 도메인 다르면 none + true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# 로그인 시 SUPER_ADMIN 자동 부여 (콤마 구분)
SUPER_ADMIN_EMAILS=
# 개발용 POST /auth/dev-login (production 에선 무시)
DEV_LOGIN_ENABLED=true

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
SWAGGER_ENABLED=true

# [v7 변경] 외부 공모전 자동 수집 (매일 06:00 KST + 관리자 /admin/crawler '지금 수집')
CRAWL_ENABLED=true
# 비우면 기본 UA
CRAWL_USER_AGENT=
# 요청 간격(ms)
CRAWL_DELAY_MS=800
# [v7 변경] data.go.kr '창업진흥원_K-Startup 조회서비스'(15125364) 활용신청 → 일반 인증키(Decoding). 비우면 비활성
KSTARTUP_API_KEY=
# [v7 변경] 공고명 키워드 필터 (콤마, 비우면 전부)
KSTARTUP_KEYWORDS=경진대회,공모전,해커톤,챌린지,대회,데모데이,오디션,예비창업,창업동아리,아이디어
# [v7 변경] 위비티 목록 페이지 수 (0 = 끔)
WEVITY_PAGES=3
# [v7 변경] GIST 공지 목록 URL (콤마). robots.txt 차단 → 학교 허가 후 입력. 비우면 끔
GIST_NOTICE_URLS=
GIST_KEYWORDS=공모전,경진대회,해커톤,대회,창업,챌린지,모집
