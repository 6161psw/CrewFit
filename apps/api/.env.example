NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://crewfit:crewfit@localhost:5432/crewfit

API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# 추가 허용 origin (콤마 구분)
CORS_ALLOWED_ORIGINS=

JWT_SECRET=change-me-to-long-random-string
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google Cloud Console > OAuth 클라이언트(웹). 리디렉션 URI = GOOGLE_CALLBACK_URL
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# 앱(iOS/Android) idToken audience 추가 (콤마 구분)
GOOGLE_MOBILE_CLIENT_IDS=

# 웹/API 도메인 다르면 none + true
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# 로그인 시 SUPER_ADMIN 자동 부여 (콤마 구분)
SUPER_ADMIN_EMAILS=
# 개발용 POST /auth/dev-login (production 에선 무시)
DEV_LOGIN_ENABLED=true

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
SWAGGER_ENABLED=true
