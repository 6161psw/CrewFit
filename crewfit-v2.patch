+
+  /** 설정 */
+  @Patch('me')
+  updateMe(@GetUser() user: AuthUser, @Body() dto: UpdateAdminMeDto) {
+    return this.accountService.updateMe(user, dto);
+  }
+
+  /** 동료 관리자 초대 코드 발급 */
+  @Post('invites')
+  createInvite(@GetUser() user: AuthUser, @Body() dto: CreateInviteDto) {
