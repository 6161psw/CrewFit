@@ -0,0 +1,129 @@
+import { Injectable, Logger } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { ContestScope, ContestSource } from '@prisma/client';
+import { csv, Env } from '../../config/env.validation';
+import { ContestSourceAdapter, CrawledContest, SourceResult } from '../crawler.types';
+import { fetchJson, sleep } from '../util/http.util';
+import { clean, clip, guessCategory, keywordFilter, parseYmd } from '../util/parse.util';
+
+/** 공공데이터포털 15125364 창업진흥원_K-Startup 사업공고 */
+const ENDPOINT = 'https://apis.data.go.kr/B552735/kisedKstartupService01/getAnnouncementInformation01';
+const PER_PAGE = 100;
+const MAX_PAGES = 10;
+
+interface KsItem {
+  pbanc_sn?: number | string;
+  biz_pbanc_nm?: string;
+  intg_pbanc_biz_nm?: string;
+  pbanc_ntrp_nm?: string;
+  sprv_inst?: string;
+  pbanc_ctnt?: string;
+  aply_trgt_ctnt?: string;
+  aply_trgt?: string;
+  supt_biz_clsfc?: string;
+  supt_regin?: string;
+  pbanc_rcpt_bgng_dt?: string;
+  pbanc_rcpt_end_dt?: string;
+  detl_pg_url?: string;
+  biz_aply_url?: string;
+  biz_gdnc_url?: string;
+  rcrt_prgs_yn?: string;
+}
+
+interface KsResponse {
+  data?: KsItem[];
+  totalCount?: number;
+  matchCount?: number;
+}
+
+/** supt_regin → 크루핏 region. 전국/빈값 → 전국, 여기 없는 지역 → 버림 */
+const REGION_MAP: Record<string, string> = { 광주: '광주·전남', 전남: '광주·전남' };
+
+@Injectable()
+export class KStartupSource implements ContestSourceAdapter {
+  readonly key = ContestSource.KSTARTUP;
+  readonly name = 'K-Startup 사업공고 (창업진흥원 API)';
+  private readonly logger = new Logger(KStartupSource.name);
+
+  constructor(private readonly config: ConfigService<Env, true>) {}
+
+  private get apiKey() {
+    return this.config.get('KSTARTUP_API_KEY', { infer: true });
+  }
+
+  enabled() {
+    return !!this.apiKey;
+  }
+
+  disabledReason() {
+    return this.enabled() ? null : 'KSTARTUP_API_KEY 없음';
+  }
+
+  async fetch(): Promise<SourceResult> {
+    const ua = this.config.get('CRAWL_USER_AGENT', { infer: true });
+    const pass = keywordFilter(csv(this.config.get('KSTARTUP_KEYWORDS', { infer: true })));
+    const items: CrawledContest[] = [];
+    let skipped = 0;
+
+    for (let page = 1; page <= MAX_PAGES; page++) {
+      const qs = new URLSearchParams({
+        serviceKey: this.apiKey,
+        page: String(page),
+        perPage: String(PER_PAGE),
+        returnType: 'json',
+        'cond[rcrt_prgs_yn::EQ]': 'Y',
+      });
+      const res = await fetchJson<KsResponse>(`${ENDPOINT}?${qs}`, { userAgent: ua, timeoutMs: 20_000 });
+      const rows = res.data ?? [];
+      for (const r of rows) {
+        const c = this.map(r);
+        if (!c || !pass(c.title)) skipped++;
+        else items.push(c);
+      }
+      const total = res.matchCount ?? res.totalCount ?? 0;
+      if (rows.length < PER_PAGE || page * PER_PAGE >= total) break;
+      await sleep(300);
+    }
+    this.logger.log(`K-Startup ${items.length}건 (skip ${skipped})`);
+    return { items, skipped };
+  }
+
+  private map(r: KsItem): CrawledContest | null {
+    const id = r.pbanc_sn;
+    const title = clean(r.biz_pbanc_nm || r.intg_pbanc_biz_nm);
+    const deadline = parseYmd(r.pbanc_rcpt_end_dt);
+    if (!id || !title || !deadline) return null;
+    if (r.rcrt_prgs_yn && r.rcrt_prgs_yn !== 'Y') return null;
+
+    const regin = clean(r.supt_regin);
+    let scope: ContestScope = ContestScope.NATIONAL;
+    let region: string | null = null;
+    if (regin && !regin.includes('전국')) {
+      const hit = Object.keys(REGION_MAP).find((k) => regin.includes(k));
+      if (!hit) return null;
+      scope = ContestScope.REGION;
+      region = REGION_MAP[hit];
+    }
+
+    const organizer = clean(r.pbanc_ntrp_nm || r.sprv_inst) || '창업진흥원';
+    const target = clean(r.aply_trgt_ctnt || r.aply_trgt);
+    const body = clean(r.pbanc_ctnt);
+    const description = clip([body, target && `신청 대상: ${target}`].filter(Boolean).join('\n\n'), 3000);
+    const link = r.detl_pg_url || r.biz_aply_url || r.biz_gdnc_url || 'https://www.k-startup.go.kr';
+
+    return {
+      externalId: String(id),
+      title: clip(title, 200),
+      organizer: clip(organizer, 100),
+      description,
+      category: guessCategory(title, r.supt_biz_clsfc),
+      tags: ['K-Startup', ...(r.supt_biz_clsfc ? [clean(r.supt_biz_clsfc)] : []), ...(region ? [region] : [])],
+      scope,
+      region,
+      applyStartAt: parseYmd(r.pbanc_rcpt_bgng_dt, false),
+      deadline,
+      linkUrl: link,
+      submitTo: 'K-Startup 온라인 접수 (원문 링크)',
+    };
+  }
+}
diff --git a/CrewFit_BE/src/crawler/sources/wevity.source.ts b/CrewFit_BE/src/crawler/sources/wevity.source.ts
new file mode 100644
index 0000000..dfd8896
--- /dev/null
+++ b/CrewFit_BE/src/crawler/sources/wevity.source.ts
@@ -0,0 +1,142 @@
+import { Injectable, Logger } from '@nestjs/common';
+import { ConfigService } from '@nestjs/config';
+import { ContestScope, ContestSource } from '@prisma/client';
+import { load } from 'cheerio';
+import { Env } from '../../config/env.validation';
+import { ContestSourceAdapter, CrawledContest, SourceResult } from '../crawler.types';
+import { absUrl, fetchText, sleep } from '../util/http.util';
+import { clean, clip, deadlineFromDday, guessCategory, parseYmd } from '../util/parse.util';
+
+const BASE = 'https://www.wevity.com/';
+/** 공모전 전체 목록 (gub=1). gp=페이지 */
+const LIST_URL = (page: number) => `${BASE}?c=find&s=1&gub=1&gp=${page}`;
+
+interface Row {
+  ix: string;
+  url: string;
+  title: string;
+  field: string;
+  organizer: string;
+  dday: string;
+}
+
+/** 위비티 공모전 목록 크롤링 (robots.txt Allow:/) */
+@Injectable()
+export class WevitySource implements ContestSourceAdapter {
+  readonly key = ContestSource.WEVITY;
+  readonly name = '위비티 공모전';
+  private readonly logger = new Logger(WevitySource.name);
+
+  constructor(private readonly config: ConfigService<Env, true>) {}
+
+  enabled() {
+    return this.config.get('WEVITY_PAGES', { infer: true }) > 0;
+  }
+
+  disabledReason() {
+    return this.enabled() ? null : 'WEVITY_PAGES=0';
+  }
+
+  async fetch(): Promise<SourceResult> {
+    const ua = this.config.get('CRAWL_USER_AGENT', { infer: true });
+    const pages = this.config.get('WEVITY_PAGES', { infer: true });
+    const delay = this.config.get('CRAWL_DELAY_MS', { infer: true });
+    const rows = new Map<string, Row>();
+
+    for (let p = 1; p <= pages; p++) {
+      const html = await fetchText(LIST_URL(p), { userAgent: ua });
+      const found = this.parseList(html);
+      if (!found.length) break;
+      found.forEach((r) => rows.set(r.ix, r));
+      await sleep(delay);
+    }
+
+    const items: CrawledContest[] = [];
+    let skipped = 0;
+    for (const r of rows.values()) {
+      if (/마감(?!임박)/.test(r.dday)) {
+        skipped++;
+        continue;
+      }
+      let detail: { deadline: Date | null; start: Date | null; homepage: string | null; desc: string } = {
+        deadline: null,
+        start: null,
+        homepage: null,
+        desc: '',
+      };
+      try {
+        detail = this.parseDetail(await fetchText(r.url, { userAgent: ua }));
+      } catch (e) {
+        this.logger.warn(`상세 실패 ix=${r.ix}: ${(e as Error).message}`);
+      }
+      await sleep(delay);
+
+      const deadline = detail.deadline ?? deadlineFromDday(r.dday);
+      if (!deadline) {
+        skipped++;
+        continue;
+      }
+      const tags = r.field
+        .split(/[,/]/)
+        .map(clean)
+        .filter(Boolean)
+        .slice(0, 6);
+      items.push({
+        externalId: r.ix,
+        title: clip(r.title, 200),
+        organizer: clip(r.organizer || '위비티 공모전', 100),
+        description: detail.desc,
+        category: guessCategory(r.title, r.field),
+        tags: ['공모전', ...tags],
+        scope: ContestScope.NATIONAL,
+        applyStartAt: detail.start,
+        deadline,
+        linkUrl: r.url,
+        submitTo: detail.homepage ? `주최 측 접수 (${detail.homepage})` : '주최 측 접수 (원문 링크)',
+      });
+    }
+    this.logger.log(`위비티 ${items.length}건 (skip ${skipped})`);
+    return { items, skipped };
+  }
+
+  private parseList(html: string): Row[] {
+    const $ = load(html);
+    const out: Row[] = [];
+    // 기본 구조: ul.list > li ( .tit a / .sub-tit / .organ / .day )
+    let lis = $('ul.list > li').not('.top');
+    if (!lis.length) lis = $('a[href*="gbn=view"][href*="ix="]').closest('li');
+    lis.each((_, el) => {
+      const li = $(el);
+      const a = li.find('.tit a[href*="ix="]').first().length ? li.find('.tit a[href*="ix="]').first() : li.find('a[href*="ix="]').first();
+      const href = a.attr('href');
+      const ix = href && /[?&]ix=(\d+)/.exec(href)?.[1];
+      if (!href || !ix) return;
+      const url = absUrl(href, BASE);
+      if (!url) return;
+      const aClone = a.clone();
+      aClone.find('span, img, em, i').remove();
+      const title = clean(aClone.text()) || clean(a.text());
+      const field = clean(li.find('.sub-tit').text()).replace(/^분야\s*:?\s*/, '');
+      const organizer = clean(li.find('.organ').text());
+      const dday = clean(li.find('.day').text()) || clean(li.text());
+      if (title) out.push({ ix, url, title, field, organizer, dday });
+    });
+    return out;
+  }
+
+  /** 상세: '접수기간 2026-11-01 ~ 2026-12-05', '홈페이지 http://..' */
+  private parseDetail(html: string) {
+    const $ = load(html);
+    const text = clean($('body').text());
+    const period = /접수기간\s*:?\s*(20\d{2}[.\-/]\d{1,2}[.\-/]\d{1,2})\s*[~∼〜-]\s*(20\d{2}[.\-/]\d{1,2}[.\-/]\d{1,2})/.exec(text);
+    const homepage = /홈페이지\s*:?\s*(https?:\/\/[^\s"'<>]+)/.exec(text)?.[1] ?? null;
+    const descEl = $('#viewContents, .comm-desc, .article').first();
+    const desc = clip(clean(descEl.text()), 3000);
+    return {
+      start: period ? parseYmd(period[1], false) : null,
+      deadline: period ? parseYmd(period[2]) : null,
+      homepage,
+      desc,
+    };
+  }
+}
diff --git a/CrewFit_BE/src/crawler/util/http.util.ts b/CrewFit_BE/src/crawler/util/http.util.ts
new file mode 100644
index 0000000..430c506
--- /dev/null
+++ b/CrewFit_BE/src/crawler/util/http.util.ts
@@ -0,0 +1,41 @@
+const DEFAULT_UA = 'Mozilla/5.0 (compatible; CrewFitBot/0.1; +https://crewfit.kr)';
+
+export const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+/** charset(content-type / meta) 맞춰 디코딩 (euc-kr 게시판 대응) */
+export async function fetchText(url: string, opts: { userAgent?: string; timeoutMs?: number } = {}): Promise<string> {
+  const res = await fetch(url, {
+    headers: { 'User-Agent': opts.userAgent || DEFAULT_UA, Accept: 'text/html,application/json;q=0.9,*/*;q=0.8' },
+    signal: AbortSignal.timeout(opts.timeoutMs ?? 15_000),
+    redirect: 'follow',
+  });
+  if (!res.ok) throw new Error(`${res.status} ${res.statusText} — ${url}`);
+  const buf = new Uint8Array(await res.arrayBuffer());
+  let charset = /charset=([\w-]+)/i.exec(res.headers.get('content-type') ?? '')?.[1];
+  if (!charset) {
+    const head = new TextDecoder('latin1').decode(buf.slice(0, 2048));
+    charset = /<meta[^>]+charset=["']?([\w-]+)/i.exec(head)?.[1];
+  }
+  try {
+    return new TextDecoder((charset ?? 'utf-8').toLowerCase()).decode(buf);
+  } catch {
+    return new TextDecoder('utf-8').decode(buf);
+  }
+}
+
+export async function fetchJson<T>(url: string, opts: { userAgent?: string; timeoutMs?: number } = {}): Promise<T> {
+  const text = await fetchText(url, opts);
+  try {
+    return JSON.parse(text) as T;
+  } catch {
+    throw new Error(`JSON 아님: ${text.slice(0, 200)}`);
+  }
+}
+
+export const absUrl = (href: string, base: string) => {
+  try {
+    return new URL(href, base).toString();
+  } catch {
+    return null;
+  }
+};
